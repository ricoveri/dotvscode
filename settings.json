{
  /////////////////////////////
  // vim (the most basic thing)
  /////////////////////////////
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1 // this supposedly makes the vim extension faster
  },
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.leader": "<space>",
  "vim.easymotion": false,
  "vim.statusBarColorControl": false,
  "vim.handleKeys": {
    "<C-b>": false,
    "<C-k>": false,
    "<C-j>": false,
    "<C-w>": false,
    "<C-o>": false
  },
  /////////////////////////////////
  // Key bindings for vim emulation
  /////////////////////////////////
  "vim.normalModeKeyBindings": [
    /////////////////////////////////
    // Editor navigation
    /////////////////////////////////
    {
      "before": [
        "<leader>",
        "w",
        "h"
      ],
      "commands": [
        "workbench.action.focusLeftGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "j"
      ],
      "commands": [
        "workbench.action.focusBelowGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "k"
      ],
      "commands": [
        "workbench.action.focusAboveGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "l"
      ],
      "commands": [
        "workbench.action.focusRightGroup"
      ]
    },
    // Split editors
    {
      "before": [
        "<leader>",
        "w",
        "v"
      ],
      "commands": [
        "workbench.action.splitEditorRight"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "s"
      ],
      "commands": [
        "workbench.action.splitEditorDown"
      ]
    },
    ///////////////////////////////////
    // Editor text management
    ///////////////////////////////////
    // editor.action.changeAll
    {
      "before": [
        "g",
        "s"
      ],
      "commands": [
        "editor.action.changeAll"
      ]
    },
    ///////////////////////////////////
    // Editor management
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "w",
        "d"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "m",
        "l"
      ],
      "commands": [
        "workbench.action.moveEditorToRightGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "m",
        "h"
      ],
      "commands": [
        "workbench.action.moveEditorToLeftGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "m",
        "k"
      ],
      "commands": [
        "workbench.action.moveEditorToAboveGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "m",
        "j"
      ],
      "commands": [
        "workbench.action.moveEditorToBelowGroup"
      ]
    },
    ///////////////////////////////////
    // vim-nerdcommenter
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        ";",
        ";"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    },
    ///////////////////////////////////
    // vim-unimpaired
    ///////////////////////////////////
    {
      "before": [
        "[",
        "space"
      ],
      "commands": [
        "editor.action.insertLineBefore"
      ]
    },
    {
      "before": [
        "]",
        "space"
      ],
      "commands": [
        "editor.action.insertLineAfter"
      ]
    },
    ///////////////////////////////////
    // File management
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "f",
        "n"
      ],
      "commands": [
        "workbench.action.files.newUntitledFile"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "s"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "o"
      ],
      "commands": [
        "workbench.action.files.openFile"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    ///////////////////////////////////
    // Project management (requires project-manager extension)
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "p",
        "s"
      ],
      "commands": [
        "projectManager.saveProject"
      ]
    },
    ///////////////////////////////////
    // Debugger
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "d",
        "b"
      ],
      "commands": [
        "editor.debug.action.toggleBreakpoint"
      ]
    },
    {
      "before": [
        "<leader>",
        "d",
        "s"
      ],
      "commands": [
        "workbench.action.debug.selectandstart"
      ]
    },
    {
      "before": [
        "<leader>",
        "d",
        "<space>"
      ],
      "commands": [
        "workbench.action.debug.start"
      ]
    },
    ///////////////////////////////////
    // Task management
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "t",
        "s"
      ],
      "commands": [
        "workbench.action.tasks.runTask"
      ]
    },
    ///////////////////////////////////
    // Git
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "g",
        "f"
      ],
      "commands": [
        "git.fetchAll"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "c",
        "o"
      ],
      "commands": [
        "git.checkout"
      ]
    },
    {
      "before": [
        "<leader>",
        ";",
        "f"
      ],
      "commands": [
        "macros.quickFixmeComment"
      ]
    },
    ///////////////////////////////////
    // GitHub
    ///////////////////////////////////
    {
      "before": [
        "<leader>",
        "g",
        "h",
        "p"
      ],
      "commands": [
        "pr:github.focus"
      ]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [
        "<leader>",
        ";"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    }
  ],
  ///////////////////////////////////
  // Text editing settings
  ///////////////////////////////////
  "explorer.confirmDelete": false,
  "editor.minimap.enabled": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.tabCompletion": "on",
  "editor.cursorStyle": "line",
  "editor.formatOnType": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.autoClosingOvertype": "always",
  "editor.cursorBlinking": "solid",
  "editor.renderWhitespace": "all",
  "explorer.confirmDragAndDrop": false,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  ///////////////////////////////////
  // Editor group settings
  ///////////////////////////////////
  "workbench.colorTheme": "i3 - Tokyo Night - Custom",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 3,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.empty.hint": "hidden",
  ///////////////////////////////////
  // Look and feel
  ///////////////////////////////////
  "editor.fontFamily": "Input Mono, Source Code Pro, monospace",
  "editor.fontSize": 14,
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "editor.letterSpacing": -0.22,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "window.newWindowDimensions": "maximized",
  "window.menuBarVisibility": "toggle",
  "files.simpleDialog.enable": true,
  "editor.suggest.showMethods": true,
  "editor.suggest.preview": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.snippetSuggestions": "top",
  "editor.inlayHints.enabled": "on",
  // icons
  // ------------------------------------------------
  "workbench.startupEditor": "newUntitledFile",
  "workbench.iconTheme": "Monokai Pro (Filter Ristretto) Icons",
  "material-icon-theme.saturation": 0.7,
  "material-icon-theme.folders.color": "#26a69a",
  "material-icon-theme.folders.theme": "specific",
  "material-icon-theme.activeIconPack": "angular",
  ///////////////////////////////////
  // Syntax highlighting customizations
  ///////////////////////////////////
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword",
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": "storage.type",
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": "comment",
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },
  ///////////////////////////////////
  // Debugger
  ///////////////////////////////////
  "debug.onTaskErrors": "showErrors",
  ///////////////////////////////////
  // Security-related settings
  ///////////////////////////////////
  "security.workspace.trust.untrustedFiles": "open",
  ///////////////////////////////////
  // Zen mode
  ///////////////////////////////////
  "zenMode.showTabs": "single",
  "zenMode.fullScreen": true,
  "zenMode.hideStatusBar": false,
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideActivityBar": false,
  ///////////////////////////////////
  // Git settings
  ///////////////////////////////////
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.showProgress": true,
  "git.suggestSmartCommit": false,
  "git.blame.statusBarItem.enabled": false,
  "git.blame.editorDecoration.enabled": true,
  "git.replaceTagsWhenPull": true,
  "diffEditor.renderSideBySide": false,
  "diffEditor.ignoreTrimWhitespace": false,
  ///////////////////////////////////
  // Integrated terminal
  ///////////////////////////////////
  "terminal.integrated.env.osx": {
    "Q_NEW_SESSION": "1"
  },
  "terminal.integrated.fontSize": 13,
  "terminal.external.osxExec": "iTerm2.app",
  "terminal.integrated.commandsToSkipShell": [
    "-workbench.action.quickOpen"
  ],
  ///////////////////////////////////
  // Github
  ///////////////////////////////////
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "githubPullRequests.pushBranch": "always",
  //////////////////////////////////
  // Language/tech-specific settings
  ///////////////////////////////////
  // JSON with comments
  // ------------------------------------------------
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  // docker
  // ------------------------------------------------
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "docker.extension.enableComposeLanguageServer": false,
  },
  // vim files
  // ------------------------------------------------
  "files.associations": {
    "*.vim": "vimrc"
  },
  // YAML files
  // ------------------------------------------------
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "yaml.customTags": [
    "!Ref",
    "!GetAtt",
    "!FindInMap sequence",
    "!FindInMap scalar",
    "!GetAtt",
    "!GetAZs",
    "!Cidr",
    "!ImportValue",
    "!Join sequence",
    "!Select",
    "!Split",
    "!Sub sequence",
    "!Sub scalar",
    "!And",
    "!Equals",
    "!If",
    "!Not",
    "!Or",
    "!And sequence",
    "!If sequence",
    "!Not sequence",
    "!Equals sequence",
    "!Or sequence",
    "!FindInMap",
    "!Base64",
    "!Join",
    "!Sub",
    "!ImportValue sequence",
    "!Select sequence",
    "!Split sequence"
  ],
  // docker
  // ------------------------------------------------
  // Terraform
  "terraform.languageServer": {
    "external": true,
    "pathToBinary": "",
    "args": [
      "serve"
    ],
    "maxNumberOfProblems": 100,
    "trace.server": "off"
  },
  // Python
  // ------------------------------------------------
  "python.pythonPath": "/usr/bin/python3",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  // golang
  // ------------------------------------------------
  "go.toolsManagement.autoUpdate": true,
  "go.useLanguageServer": true,
  "go.lintOnSave": "workspace",
  "go.lintTool": "golangci-lint",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  // C/C++
  // ------------------------------------------------
  "C_Cpp.intelliSenseEngine": "Disabled",
  "clangd.checkUpdates": true
  ///////////////////////////////////
}